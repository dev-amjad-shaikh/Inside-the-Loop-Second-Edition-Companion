              "current_version": 5
            }
          ]
        }
      },
      "exports_after": []
    },
    {
      "note": "correct call",
      "call": {
        "id": "r7",
        "name": "exports_create",
        "arguments": {
          "report": "daily_orders",
          "day": "2026-09-11",
          "format": "csv",
