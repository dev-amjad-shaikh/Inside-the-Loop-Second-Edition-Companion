{
  "session": {
    "tenant": "acme",
    "user": "maria@acme",
    "grants": [
      "exports.create",
      "exports.read",
      "reports.read"
    ]
  },
  "steps": [
    {
      "note": "catalog read before the fix ships",
      "call": {
        "id": "r1",
        "name": "reports_search",
        "arguments": {
          "query": "daily orders"
        }
      },
      "observation": {
        "status": "ok",
        "effect": "read_only",
        "result": {
          "matches": [
            {
              "report": "daily_orders",
              "title": "Daily orders",
              "current_version": 4
            }
          ]
        }
      },
      "exports_after": []
    },
    {
      "note": "external event: reporting team publishes daily_orders v5 (source 339d3a9f2656, the timezone fix)"
    },
    {
      "note": "shape",
      "call": {
        "id": "r2",
        "name": "exports_create",
        "arguments": {
          "report": "daily_orders",
          "day": "Sept 11",
          "format": "CSV",
          "destination": "finance sftp",
          "expected_report_version": 4,
          "tenant": "acme"
        }
      },
      "observation": {
        "status": "input_error",
        "stage": "shape",
        "retryable": true,
        "message": "unexpected argument tenant: the tenant is taken from the signed-in session and cannot be chosen per call; day must match YYYY-MM-DD; got 'Sept 11'; format must be one of csv, parquet; got 'CSV'; destination must be one of finance_sftp, analytics_bucket; got 'finance sftp'",
        "violations": [
          {
            "path": "tenant",
            "rule": "additionalProperties",
            "message": "unexpected argument tenant: the tenant is taken from the signed-in session and cannot be chosen per call"
          },
          {
            "path": "day",
            "rule": "pattern",
            "message": "day must match YYYY-MM-DD; got 'Sept 11'"
          },
          {
            "path": "format",
            "rule": "enum",
            "message": "format must be one of csv, parquet; got 'CSV'"
          },
          {
            "path": "destination",
            "rule": "enum",
            "message": "destination must be one of finance_sftp, analytics_bucket; got 'finance sftp'"
          }
        ]
      },
      "exports_after": []
    },
    {
      "note": "cross-field",
      "call": {
        "id": "r3",
        "name": "exports_create",
        "arguments": {
          "report": "daily_orders",
          "day": "2026-09-11",
          "format": "parquet",
          "destination": "finance_sftp",
          "expected_report_version": 4
        }
      },
      "observation": {
        "status": "input_error",
        "stage": "semantics",
        "retryable": true,
        "message": "finance_sftp accepts csv only; got format parquet. Use format csv, or destination analytics_bucket for parquet."
      },
      "exports_after": []
    },
    {
      "note": "range",
      "call": {
        "id": "r4",
        "name": "exports_create",
        "arguments": {
          "report": "daily_orders",
          "day": "2026-09-12",
          "format": "csv",
          "destination": "finance_sftp",
          "expected_report_version": 4
        }
      },
      "observation": {
        "status": "input_error",
        "stage": "semantics",
        "retryable": true,
        "message": "day must be before 2026-09-12 (the service's current day); got 2026-09-12"
      },
      "exports_after": []
    },
    {
      "note": "precondition",
      "call": {
        "id": "r5",
        "name": "exports_create",
        "arguments": {
          "report": "daily_orders",
          "day": "2026-09-11",
          "format": "csv",
