        "stage": "precondition",
        "retryable": false,
        "message": "report daily_orders is at version 5 (source 339d3a9f2656), not 4. Confirm the version with the user or re-read it with reports_search before exporting.",
        "current_version": 5
      },
      "exports_after": []
    },
    {
      "note": "re-read after precondition failure",
