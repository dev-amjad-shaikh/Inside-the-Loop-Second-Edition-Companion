  "runs that used a withdrawn version": {
    "sql": "SELECT r.status, count(*) AS runs FROM rs.runs r JOIN manifest_parts mp ON mp.manifest_id = r.manifest_id JOIN parts p ON p.kind=mp.kind AND p.name=mp.name AND p.version=mp.version WHERE p.status='withdrawn' GROUP BY r.status ORDER BY r.status",
